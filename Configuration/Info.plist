<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDocumentTypes</key><array><dict>
<key>CFBundleTypeName</key><string>Receipt documents</string>
<key>CFBundleTypeRole</key><string>Viewer</string>
<key>LSHandlerRank</key><string>Alternate</string>
<key>LSItemContentTypes</key><array><string>com.adobe.pdf</string><string>public.png</string><string>public.jpeg</string><string>public.heic</string><string>com.apple.mail.email</string></array>
</dict></array>
<key>PaperloftAppGroupIdentifier</key><string>$(TeamIdentifierPrefix)app.paperloft.receipts</string>
<key>PaperloftAppGroupEnabled</key><string>$(PAPERLOFT_APP_GROUP_ENABLED)</string>
<!-- The pipeline's one signpost (UnderstandInboxBatch, no user data) is written to disk rather than the
     shared memory buffer, which the on-device model's own signposts overrun within minutes. AC-10's
     XCTOSSignpostMetric reads it back after a 100-document batch. -->
<key>OSLogPreferences</key><dict><key>app.paperloft.receipts</key><dict><key>Pipeline</key><dict>
<key>Signpost-Persisted</key><true/>
</dict></dict></dict>
</dict></plist>
